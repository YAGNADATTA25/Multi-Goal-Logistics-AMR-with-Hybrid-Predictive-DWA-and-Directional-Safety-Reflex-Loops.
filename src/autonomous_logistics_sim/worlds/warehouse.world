<plugin name="controller_1" filename="libgazebo_ros_planar_move.so">
  <ros>
    <remapping>cmd_vel:=cmd_vel_obstacle_1</remapping>
    <remapping>odom:=odom_obstacle_1</remapping>
  </ros>
  <update_rate>20</update_rate>
  <robot_base_frame>warehouse_worker_1</robot_base_frame> 
</plugin>
